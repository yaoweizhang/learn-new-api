# Upstream provider keys (one or more required to actually relay traffic)
UPSTREAM_OPENAI_KEY=
UPSTREAM_CLAUDE_KEY=
UPSTREAM_GEMINI_KEY=

# Gateway secrets
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# Optional infra
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO